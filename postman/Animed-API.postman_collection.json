        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Garante um token antes de qualquer requisição autenticada,",
          "// para que cada pasta possa ser executada isoladamente.",
          "if (!pm.collectionVariables.get('token')) {",
          "  pm.sendRequest({",
          "    url: pm.collectionVariables.get('baseUrl') + '/api/auth/login',",
          "    method: 'POST',",
          "    header: { 'Content-Type': 'application/json' },",
          "    body: { mode: 'raw', raw: JSON.stringify({",
          "      email: 'tutor@animed.com.br', senha: 'animed123' }) },",
          "  }, (erro, resposta) => {",
          "    if (erro) return;",
          "    const corpo = resposta.json();",
          "    pm.collectionVariables.set('token', corpo.token);",
          "    pm.collectionVariables.set('idTutor', corpo.idTutor);",
          "  });",
          "}"
        ]
      }
    }
  ]
