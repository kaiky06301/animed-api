{
  "info": {
    "name": "Animed API",
    "description": "API do Animed — Challenge FIAP 2026 com a Clyvo VET.\n\nA API exige autenticação: rode **00 - Autenticação › Login** antes de tudo. O token é guardado na coleção automaticamente.\n\nAs pastas marcadas com DOUTOR precisam do login da veterinária; as demais, do tutor.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "idTutor",
      "value": "4"
    },
    {
      "key": "idPet",
      "value": "5"
    }
  ],
  "item": [
    {
      "name": "00 - Autenticação",
      "description": "Comece por aqui: o login guarda o token e libera as outras pastas.",
      "item": [
        {
          "name": "Login — tutor",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"tutor@animed.com.br\",\n  \"senha\": \"animed123\"\n}"
            },
            "description": "Guarda o token na variável da coleção; as demais requisições o usam.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const corpo = pm.response.json();",
                  "pm.collectionVariables.set('token', corpo.token);",
                  "if (corpo.idTutor) pm.collectionVariables.set('idTutor', corpo.idTutor);",
                  "",
                  "pm.test('autenticou', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login — veterinária",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"doutor@animed.com.br\",\n  \"senha\": \"animed123\"\n}"
            },
            "description": "Guarda o token na variável da coleção; as demais requisições o usam.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const corpo = pm.response.json();",
                  "pm.collectionVariables.set('token', corpo.token);",
                  "if (corpo.idTutor) pm.collectionVariables.set('idTutor', corpo.idTutor);",
                  "",
                  "pm.test('autenticou', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Registrar tutor",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/registrar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "registrar"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Novo Tutor\",\n  \"email\": \"novo@animed.com.br\",\n  \"senha\": \"animed123\",\n  \"cpf\": \"111.222.333-44\",\n  \"telefone\": \"(11) 91234-5678\",\n  \"role\": \"TUTOR\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Trocar a própria senha",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/senha",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "senha"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"senhaAtual\": \"animed123\",\n  \"novaSenha\": \"novaSenha123\"\n}"
            },
            "description": "Exige a senha atual. Não rode junto com a pasta inteira: trocaria a senha da conta de demonstração."
          }
        }
      ]
    },
