# Copie para .env e preencha. NAO commite o .env.

# Senha do administrador do Oracle (SYS/SYSTEM) no container
ORACLE_PASSWORD=TroqueEstaSenha1

# Usuario que a aplicacao usa para gravar. O container do Oracle cria
# esse usuario na primeira subida; o schema tem o mesmo nome, em maiusculas.
APP_USER=clyvo
APP_USER_PASSWORD=TroqueEstaSenha1
ORACLE_DATABASE=CLYVOVET
ORACLE_SCHEMA=CLYVO

# ATENCAO: precisa ser Base64 PURO (so A-Z a-z 0-9 + / =).
# O JwtService faz Decoders.BASE64.decode(): um valor com '-' ou '_'
# derruba a API na subida, com "Illegal base64 character".
#   Linux/Mac : openssl rand -base64 48
#   PowerShell: $b=New-Object byte[] 48; `
#               [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); `
#               [Convert]::ToBase64String($b)
ANIMED_JWT_SECRET=Y29sb3F1ZS1hcXVpLXVtLXNlZ3JlZG8tZ2VyYWRvLWRlLXZlcmRhZGUtbmFvLWVzdGU=

# Opcionais (o script usa estes valores por padrao)
LOCATION=brazilsouth
RG=rg-animed-sprint3
